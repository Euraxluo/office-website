{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/v:version/web-apps/:rest*.html",
            "destination": "/v:version/web-apps/:rest*"
        }
    ],
    "headers": [
        {
            "source": "/x2t/x2t.wasm",
            "headers": [
                {
                    "key": "Content-Encoding",
                    "value": "br"
                }
            ]
        },
        {
            "source": "/x2t-:suffix/:path*",
            "headers": [
                {
                    "key": "Content-Encoding",
                    "value": "br"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31556952, immutable"
                }
            ]
        }
    ]
}